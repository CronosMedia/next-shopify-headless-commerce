{
  "name": "next-commerce",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "codegen": "node --env-file-if-exists=.env node_modules/@graphql-codegen/cli/cjs/bin.js --config codegen.ts",
    "dev": "next dev --webpack",
    "dev:https": "next dev --webpack -H 0.0.0.0 --experimental-https",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit --incremental false",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@shopify/storefront-api-client": "^1.0.10",
    "iron-session": "^8.0.0",
    "lenis": "^1.3.23",
    "lucide-react": "^0.473.0",
    "next": "16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.1.2",
    "@graphql-codegen/typescript": "^6.0.2",
    "@graphql-codegen/typescript-operations": "^6.0.4",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/postcss": "^4.3.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^22.19.21",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "baseline-browser-mapping": "^2.10.37",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss": "8.5.15"
  }
}
